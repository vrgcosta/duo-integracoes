{
  "id": "ChatGPT-WEB-NATIVO",
  "rotulo": "Plugin (ChatGPT web)",
  "icone": "nossos-openai",
  "baseURL": "https://chatgpt.com",
  "sessao": true,
  "execucao": "pagina",
  "identidade": [
    "contaId"
  ],
  "headers": {},
  "modelos": [
    {
      "id": "padrao",
      "label": "Padrão da conta"
    }
  ],
  "contexto": [],
  "conversas": {
    "listar": {
      "caminho": "/backend-api/conversations?offset=0&limit=100&order=updated&is_archived=false",
      "itens": "items",
      "id": "id",
      "titulo": "title",
      "atualizadoEm": "update_time",
      "projetoId": "gizmo_id"
    },
    "ler": {
      "caminho": "/backend-api/conversation/{convId}",
      "itens": "mapping",
      "itensMapa": true,
      "arvore": {
        "uuid": "id",
        "parent": "parent",
        "raiz": "client-created-root",
        "folhaAtiva": "current_node"
      },
      "role": {
        "campo": "message.author.role",
        "mapa": {
          "user": "user",
          "assistant": "assistant"
        }
      },
      "texto": {
        "blocos": {
          "em": "message.content.parts",
          "filtroCampo": "",
          "filtroValor": "",
          "campoTexto": ""
        }
      }
    },
    "renomear": {
      "metodo": "PATCH",
      "caminho": "/backend-api/conversation/{convId}",
      "corpo": {
        "title": "{titulo}"
      }
    },
    "excluir": {
      "metodo": "PATCH",
      "caminho": "/backend-api/conversation/{convId}",
      "corpo": {
        "is_visible": false
      }
    },
    "buscar": {
      "caminho": "/backend-api/conversations/search?query={termo}&cursor=",
      "itens": "items",
      "id": "conversation_id",
      "titulo": "title",
      "atualizadoEm": "update_time"
    },
    "projetos": {
      "caminho": "/backend-api/gizmos/snorlax/sidebar?conversations_per_gizmo=0&limit=50&owned_only=false",
      "itens": "items",
      "id": {
        "caminho": "gizmo.gizmo.id"
      },
      "nome": {
        "caminho": "gizmo.gizmo.display.name"
      },
      "rotulo": "GPT"
    },
    "projetoConversas": {
      "caminho": "/backend-api/gizmos/{projetoId}/conversations?cursor=0",
      "itens": "items",
      "id": "id",
      "titulo": "title",
      "atualizadoEm": "update_time"
    }
  },
  "enviar": {
    "caminho": "/backend-api/f/conversation",
    "corpo": {}
  },
  "stream": {
    "framing": "sse",
    "delta": {
      "versao": "v1",
      "campoIndiceMensagem": "c",
      "envelope": {
        "mensagem": "message",
        "conversaId": "conversation_id",
        "erro": "error"
      },
      "eventos": {
        "campoTipo": "type",
        "eventoDelta": "delta",
        "handshake": "delta_encoding",
        "feito": "[DONE]",
        "campoConversaId": "conversation_id",
        "titulo": {
          "tipo": "title_generation",
          "campo": "title"
        },
        "fim": [
          "message_stream_complete"
        ],
        "erro": {
          "tipos": [
            "error"
          ],
          "campos": [
            "error",
            "message"
          ]
        }
      },
      "visivel": [
        {
          "caminho": "author.role",
          "em": [
            "assistant"
          ]
        },
        {
          "caminho": "content.content_type",
          "em": [
            "text",
            "multimodal_text"
          ]
        },
        {
          "caminho": "recipient",
          "em": [
            null,
            "all"
          ]
        },
        {
          "caminho": "channel",
          "em": [
            null,
            "final"
          ]
        },
        {
          "caminho": "metadata.is_visually_hidden_from_conversation",
          "em": [
            null,
            false
          ]
        }
      ],
      "raciocinio": [
        {
          "caminho": "author.role",
          "em": [
            "assistant"
          ]
        },
        {
          "caminho": "content.content_type",
          "em": [
            "thoughts",
            "reasoning_recap"
          ]
        }
      ],
      "textoVisivel": {
        "em": "content.parts",
        "campoTextoItem": "text"
      },
      "textoRaciocinio": {
        "direto": {
          "quando": {
            "caminho": "content.content_type",
            "em": [
              "reasoning_recap"
            ]
          },
          "pega": "content.content",
          "rotulo": true
        },
        "blocos": {
          "em": "content.thoughts",
          "campos": [
            "summary",
            "content"
          ],
          "sepCampos": "\n",
          "sepBlocos": "\n\n"
        }
      }
    },
    "limpezaTexto": [
      {
        "de": "",
        "ate": ""
      },
      {
        "de": "<Cite ",
        "ate": "/>"
      },
      {
        "de": ":::",
        "ate": "\n"
      }
    ]
  },
  "sessoes": {
    "padrao": 2,
    "limite": 5,
    "intervaloInicioMs": 1000
  },
  "ferramentas": {
    "emulacao": "cercas",
    "limiteInline": 24000,
    "maxRodadas": 15
  },
  "configuraveis": [
    {
      "caminho": "ferramentas.maxRodadas",
      "rotulo": "Máximo de rodadas de ferramentas",
      "descricao": "Quantas vezes seguidas a IA pode pedir ferramentas num mesmo turno. Tarefas com muitos processos precisam de mais.",
      "tipo": "numero",
      "min": 1,
      "max": 200
    }
  ],
  "pagina": {
    "seletores": {
      "editor": "form div.ProseMirror[contenteditable=\"true\"]",
      "enviar": "form button[type=\"submit\"]",
      "parar": "form button[data-testid=\"stop-button\"], form button[aria-label*=\"Parar\" i], form button[aria-label*=\"Stop\" i]",
      "seletorModelo": "form button[aria-haspopup=\"menu\"][data-composer-navigation-target=\"reasoning\"]",
      "seletorModeloAlt": "form button[aria-haspopup=\"menu\"][aria-label*=\"modelo\" i], form button[aria-haspopup=\"menu\"][aria-label*=\"model\" i]",
      "menu": "[role=\"menu\"]",
      "itemModelo": "[role=\"menuitemradio\"]",
      "esforco": "[role=\"slider\"]",
      "arquivo": "input[type=\"file\"]"
    },
    "avisos": [
      {
        "padrao": "too many requests|requests too quickly|temporarily limited access|muitas solicita[cç][oõ]es|solicita[cç][oõ]es (muito )?r[aá]pid|limitamos temporariamente",
        "mensagem": "O ChatGPT limitou temporariamente a sua conta por excesso de pedidos seguidos. Aguarde alguns minutos antes de tentar de novo (abrir muitas conversas de uma vez provoca isso)."
      },
      {
        "padrao": "reached (your|the) .{0,40}limit|hit (your|the) .{0,30}limit|atingiu (o|seu) limite",
        "mensagem": "Você atingiu o limite de uso deste modelo no ChatGPT. Escolha outro modelo ou aguarde o horário de liberação que o ChatGPT indicar."
      },
      {
        "padrao": "session (has )?expired|sess[aã]o (expirou|expirada)|log in again|fa[cç]a login novamente|entre novamente",
        "mensagem": "A sessão do ChatGPT expirou. Abra o ChatGPT no navegador, entre de novo e repita o pedido."
      }
    ],
    "navegarPara": {
      "conversa": "/c/{convId}",
      "projeto": "/g/{projetoUrl}/project",
      "raiz": "/"
    },
    "leituraVia": "pagina",
    "rede": {
      "reEnvio": "^/backend-api/(f/)?conversation$",
      "reUpload": "/backend-api/files|oaiusercontent|blob\\.core\\.windows\\.net",
      "reApiProibida": "/f/conversation|/sentinel/",
      "apiPrefixo": "/backend-api/",
      "caminhoSessao": "/api/auth/session",
      "headerConta": "ChatGPT-Account-Id",
      "campoAccessToken": "accessToken",
      "campoContaId": "account.id",
      "hostWs": "chatgpt.com",
      "polling": {
        "campoConversaEnviada": "conversation_id",
        "campoMensagemEnviada": "messages.0.id",
        "concluida": {
          "status": "finished_successfully",
          "end_turn": "true"
        }
      },
      "envioDireto": {
        "caminho": "/backend-api/f/conversation",
        "corpo": {
          "action": "next",
          "messages": [
            {
              "id": "{mensagemId}",
              "author": {
                "role": "user"
              },
              "create_time": "{agoraSeg}",
              "content": {
                "content_type": "text",
                "parts": [
                  "{prompt}"
                ]
              },
              "metadata": {}
            }
          ],
          "parent_message_id": "{pai}",
          "model": "{modelo}",
          "timezone_offset_min": "{fusoMin}",
          "timezone": "{fuso}",
          "conversation_mode": {
            "kind": "primary_assistant"
          },
          "enable_message_followups": false,
          "system_hints": [],
          "supports_buffering": true,
          "supported_encodings": [
            "v1"
          ],
          "client_contextual_info": {
            "is_dark_mode": false,
            "time_since_loaded": 60,
            "page_height": "{alturaPagina}",
            "page_width": "{larguraPagina}",
            "pixel_ratio": "{densidade}",
            "screen_height": "{alturaTela}",
            "screen_width": "{larguraTela}",
            "app_name": "chatgpt.com"
          },
          "paragen_cot_summary_display_override": "allow",
          "force_parallel_switch": "auto"
        },
        "corpoConversa": {
          "conversation_id": "{convId}"
        },
        "corpoProjeto": {
          "conversation_mode": {
            "kind": "gizmo_interaction",
            "gizmo_id": "{projetoId}"
          },
          "gizmo_id": "{projetoId}"
        },
        "paiNovo": "client-created-root",
        "conversa": {
          "caminho": "/backend-api/conversation/{convId}",
          "noAtual": "current_node",
          "projeto": "gizmo_id"
        },
        "campoNivel": "thinking_effort",
        "cabecalhos": {
          "oai-device-id": "{dispositivo}",
          "oai-client-version": "{versaoCliente}",
          "oai-language": "pt-BR"
        },
        "chaveDispositivo": "oai-did",
        "cabecalhoVersao": "oai-client-version",
        "sentinela": {
          "caminho": "/backend-api/sentinel/chat-requirements",
          "corpo": {
            "p": ""
          },
          "token": "token",
          "cabecalhoToken": "openai-sentinel-chat-requirements-token",
          "prova": {
            "exigida": "proofofwork.required",
            "semente": "proofofwork.seed",
            "dificuldade": "proofofwork.difficulty",
            "cabecalho": "openai-sentinel-proof-token",
            "prefixo": "gAAAAAB",
            "posicaoContador": 3,
            "molde": [
              "{telaSoma}",
              "{dataTexto}",
              4294967296,
              0,
              "{agenteUsuario}",
              null,
              "{versaoCliente}",
              "{idioma}",
              "{idiomas}",
              "{densidade}",
              "",
              "{atributoReact}",
              "{eventoWebkit}",
              "{alturaExterna}",
              "{dispositivo}",
              "",
              "{nucleos}",
              "{agoraMs}",
              0,
              0,
              0,
              0,
              0,
              0,
              0
            ]
          },
          "verificacao": {
            "exigida": "turnstile.required",
            "valor": "turnstile.dx",
            "cabecalho": "openai-sentinel-turnstile-token"
          }
        },
        "modelos": {
          "caminho": "/backend-api/models?history_and_training_disabled=false",
          "itens": "models",
          "id": "slug",
          "padrao": "default_model_slug",
          "campoTipo": "reasoning_type",
          "valorRaciocinio": "reasoning",
          "campoAjustavel": "configurable_thinking_effort",
          "niveis": {
            "em": "thinking_efforts",
            "campo": "thinking_effort"
          },
          "ordemNiveis": [
            "max",
            "extended",
            "standard",
            "min"
          ],
          "reserva": "auto",
          "semRaciocinio": {
            "valor": "none",
            "preferidos": [
              "{padrao}-instant"
            ]
          },
          "preferidosRaciocinio": [
            "{padrao}-thinking"
          ],
          "listar": {
            "campo": "reasoning_type",
            "valor": "auto",
            "rotulo": "title"
          }
        },
        "anexos": {
          "campo": "messages.0.metadata.attachments",
          "molde": {
            "id": "{id}",
            "name": "{nome}",
            "size": "{tamanho}",
            "mimeType": "{mime}"
          },
          "criar": {
            "caminho": "/backend-api/files",
            "corpo": {
              "file_name": "{nome}",
              "file_size": "{tamanho}",
              "use_case": "my_files"
            },
            "urlEnvio": "upload_url",
            "id": "file_id"
          },
          "cabecalhosEnvio": {
            "Content-Type": "{mime}",
            "x-ms-blob-type": "BlockBlob"
          },
          "confirmar": {
            "caminho": "/backend-api/files/{id}/uploaded",
            "corpo": {},
            "tentativas": 3
          }
        },
        "recusa": {
          "padrao": "unusual activity|atividade incomum",
          "pausaMin": 60
        }
      }
    },
    "corpoPensamento": {
      "ligado": {
        "thinking_effort": "{nivelPensamento}"
      },
      "desligado": {}
    },
    "descobrirModelos": false
  },
  "niveisPensamento": [
    {
      "valor": "min",
      "rotulo": "Leve"
    },
    {
      "valor": "standard",
      "rotulo": "Média",
      "padrao": true
    },
    {
      "valor": "extended",
      "rotulo": "Alta"
    },
    {
      "valor": "max",
      "rotulo": "Extra alto",
      "detalhe": "consome a cota mais rápido"
    }
  ],
  "versao": "1.1.2",
  "versaoFormato": 1,
  "compatibilidade": {
    "extensaoMinima": "3.71.141"
  },
  "atualizacao": {
    "url": "https://raw.githubusercontent.com/vrgcosta/duo-integracoes/main/plugins/chatgpt-web.blueprint.json"
  }
}
